table claims_cleaned
	lineageTag: 9bce5da4-a7a1-460d-a1ce-c185bc9514e2
	sourceLineageTag: [dbo].[claims_cleaned]

	measure 'Total Claims' = COUNTROWS('claims_cleaned')
		formatString: 0
		lineageTag: a5e8ba58-a383-4dc4-900a-09299d75844e

		changedProperty = Name

	measure 'Total Claim Amount' = SUM('claims_cleaned'[claim_amount])
		lineageTag: d925f5df-64fb-4c31-876a-84bb63f6abd5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fraud Rate' =
			
			DIVIDE(
			    CALCULATE([Total Claims], 'claims_cleaned'[is_fraud_flag] = 1),
			    [Total Claims],
			    0
			)
		lineageTag: 09032ce5-a46d-42ab-a24d-9d6f68520209

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Claim Severity' = AVERAGE('claims_cleaned'[claim_amount])
		lineageTag: 4a1ae2dc-d449-47e3-b0e1-8683865791d5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Baseline Fraud Rate' =
			
			CALCULATE(
			    DIVIDE(
			        CALCULATE([Total Claims], 'claims_cleaned'[is_fraud_flag] = 1),
			        [Total Claims],
			        0
			    ),
			    ALL('claims_cleaned') // <--- THIS forces it to ignore the slicers
			)
		lineageTag: 4d71c8a7-7e61-4843-9856-6aa451995822

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Segment Fraud Rate' =
			
			VAR CurrentRegion = SELECTEDVALUE('claims_cleaned'[region])
			VAR CurrentCategory = SELECTEDVALUE('claims_cleaned'[vehicle_category])
			
			RETURN
			CALCULATE(
			    DIVIDE(
			        CALCULATE([Total Claims], 'claims_cleaned'[is_fraud_flag] = 1),
			        [Total Claims],
			        0
			    ),
			    // Only apply filters if a single value is selected; otherwise calculate for all
			    FILTER(
			        ALLSELECTED('claims_cleaned'),
			        ('claims_cleaned'[region] = CurrentRegion || ISBLANK(CurrentRegion)) &&
			        ('claims_cleaned'[vehicle_category] = CurrentCategory || ISBLANK(CurrentCategory))
			    )
			)
		lineageTag: 6503a3f4-0a63-435c-8cc0-71fc61c3fdce

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fraud Lift %' = ```
			
			VAR CurrentRate = [Segment Fraud Rate]
			VAR BaseRate = CALCULATE([Baseline Fraud Rate], ALL('claims_cleaned'))
			RETURN
			IF(ISBLANK(CurrentRate) || ISBLANK(BaseRate) || BaseRate = 0, 
			   BLANK(), 
			   DIVIDE(CurrentRate - BaseRate, BaseRate, 0)
			)
			```
		lineageTag: 25b9b902-187c-43c9-8594-f9ce3b5f0faf

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

